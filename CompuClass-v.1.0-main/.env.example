# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are compiled into the app and visible to anyone, so
# only put values here that are safe to be public.

# Public by design; data is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# true = AI requests go through the gemini-proxy Edge Function (key stays server-side).
EXPO_PUBLIC_USE_AI_PROXY=false

# Legacy direct mode only. This key ships in the app bundle. Remove it once
# proxy mode is on (see supabase/functions/gemini-proxy/README.md).
EXPO_PUBLIC_GEMINI_API_KEY=
