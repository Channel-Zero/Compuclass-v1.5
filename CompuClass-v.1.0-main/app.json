{
  "expo": {
    "name": "CompuClass",
    "slug": "CompuClass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.compuclass.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is required for AR experiences.",
        "NSPhotoLibraryUsageDescription": "Allow CompuClass to save documents",
        "NSPhotoLibraryAddUsageDescription": "Allow CompuClass to save documents to your device"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.compuclass.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "description": "CompuClass is an interactive computer learning platform: build a PC in a virtual lab, practise Windows 11, take quizzes and track your progress.",
      "themeColor": "#2563EB",
      "lang": "en"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-speech-recognition",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "de58943b-ff1e-4471-85dd-37198408d602"
      }
    }
  }
}
